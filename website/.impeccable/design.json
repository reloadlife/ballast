  "narrative": {
    "northStar": "Room to Breathe",
    "overview": "Ballast's website makes disk space feel tangible through a softly shaded segmented sculpture, warm paper surfaces, and generous room around plain language. Manrope supplies a precise but approachable voice for the broad Mac audience; developer details remain readable supporting evidence.\n\nThis is the website system, scoped to `website/`. The native SwiftUI application's root `DESIGN.md` remains its own authority. Product facts and image provenance constrain the presentation: actual app captures are labeled, illustrative surroundings are disclosed, and the sculpture never pretends to show a visitor's disk.",
    "keyCharacteristics": [
      "Warm paper, charcoal type, and purposeful orange accents.",
      "Large restrained headlines and spacious split compositions.",
      "Physical depth in illustrations; quiet controls and content surfaces.",
      "Motion on request, with immediate reduced-motion state changes."
    ],
    "rules": [
      {
        "name": "The Readable Orange Rule",
        "body": "Use burnt orange for text and focus; reserve bright orange for illustration and category marks.",
        "section": "colors"
      },
      {
        "name": "The Plain Language Rule",
        "body": "Let headlines explain the benefit and nearby prose explain the mechanism. Keep filenames in the developer context.",
        "section": "typography"
      },
      {
        "name": "The Evidence Has Depth Rule",
        "body": "Use physical framing to explain storage or show the application; keep reading surfaces calm.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve a complete readable page before interactive artwork loads.",
      "**Do** use burnt orange for readable emphasis and charcoal for the main action.",
      "**Do** distinguish actual application evidence from illustrative framing.",
      "**Do** maintain visible keyboard focus and immediate reduced-motion state changes."
    ],
    "donts": [
      "**Don't** make the canvas the only source of product information.",
      "**Don't** extend the illustration's depth treatment to every reading surface.",
      "**Don't** infer native application styling from this website system.",
      "**Don't** treat unused fallback CSS or superseded declarations as design tokens."
    ]
  }
